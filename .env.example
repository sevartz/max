# Конфиг ctxads. Скопируйте в .env и заполните: cp .env.example .env
# Комментарии пишите только на отдельной строке: после пустого "КЛЮЧ=" комментарий
# прочитается как значение.

# ===== Обязательно заполнить =====

# Токен бота MAX
MAX_BOT_TOKEN=

# Ключ NVIDIA NIM (nvapi-...) с build.nvidia.com
LLM_API_KEY=

# Модель из каталога NIM (режим рассуждений бот выключает сам)
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# ===== Локальный запуск: можно не менять =====

DATABASE_URL=postgresql+asyncpg://ctx:ctx@localhost:5432/ctx

# Адрес, на который ведут ссылки "Подробнее" в рекламе (/r/{token}).
# Локально — localhost; на сервере — https://<ваш домен>, иначе клики не заработают.
PUBLIC_BASE_URL=http://localhost:8000

# Публичный HTTPS URL мини-приложения MAX, например https://bot.example.com/miniapp/.
MINIAPP_URL=

# Соль для хэширования IP в кликах; перед показом замените на случайную строку (openssl rand -hex 16)
CLICK_SALT=change-me

MAX_API_BASE=https://platform-api2.max.ru

# Провайдер LLM: openai_compat (NVIDIA NIM) | yandexgpt | gigachat | fake
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Клиентский лимит запросов в минуту (у бесплатного NIM ~40)
LLM_RPM=30

# Эмбеддер: e5_local (модель скачается при первом запуске, ~120 МБ) | fake
EMBEDDER=e5_local

# Доля платформы с оплаты рекламодателя
PLATFORM_FEE=0.3
# Сколько минут предложение ждёт решения админа
PROPOSAL_TTL_MIN=120
# Порог соответствия рекламы посту (0..1); ниже — "ничего не подходит"
MIN_MATCH_SCORE=0.35

# ===== Только для webhook-режима на сервере (--mode webhook) =====
# На сервере раскомментируйте и заполните ОБА поля: без них бот в режиме webhook не стартует.
# Без секрета кто угодно мог бы слать боту поддельные события (например, «Одобрить»).
# Секрет сгенерируйте так: openssl rand -hex 32

# WEBHOOK_PUBLIC_URL=https://bot.example.com/webhook/max
# WEBHOOK_SECRET=

# ===== Опционально: запасной LLM-провайдер =====

# Включается при исчерпании кредитов NIM или постоянных 429: yandexgpt | gigachat
# LLM_FALLBACK_PROVIDER=yandexgpt
# Ключ запасного провайдера (YandexGPT Api-Key / GigaChat auth key)
# LLM_FALLBACK_API_KEY=
# Только для YandexGPT
# LLM_FOLDER_ID=
